                    "copyInputFields": [
                        {
                            "description": "Use the following URL as the <strong>Authorized Redirect URI</strong>.",
                            "value": "redirect_uri"
                        }
                    ],
                    "header": "Prerequisites",
                    "paragraphs": [
                        "Before you begin, register an <strong>OIDC client</strong> in your Daon TrustX tenant and obtain a <strong>Client ID & secret</strong>. Note the Daon <strong>authorization</strong> and <strong>token</strong> endpoint URLs, and the <strong>enrol process definition</strong> used for registration and invited-user enrolment. After creation, reference this connection from a <strong>Daon TrustX Authenticator</strong> connection (used for login) using its resource ID."
                    ]
                },
                "fields": [
                    {
                        "fieldName": "Name",
                        "hint": "Provide a unique name for the connection."
                    },
                    {
                        "fieldName": "Client ID",
                        "hint": "Provide the <Code class=\"inline-code\">Client ID</Code> of the OIDC client registered in the Daon TrustX tenant."
                    },
                    {
                        "fieldName": "Client Secret",
                        "hint": "Provide the <Code class=\"inline-code\">Client Secret</Code> of the OIDC client registered in the Daon TrustX tenant."
                    },
                    {
                        "fieldName": "Authorization Endpoint URL",
                        "hint": "The Daon TrustX OIDC <Code class=\"inline-code\">authorization</Code> endpoint URL."
                    },
                    {
                        "fieldName": "Token Endpoint URL",
                        "hint": "The Daon TrustX OIDC <Code class=\"inline-code\">token</Code> endpoint URL."
                    },
                    {
                        "fieldName": "Scopes",
                        "hint": "OIDC scopes to request from Daon. Include <Code class=\"inline-code\">document</Code> to receive verified claims."
                    },
                    {
                        "fieldName": "Enrol Process Definition",
                        "hint": "Daon process definition used for the enrolment flows (registration and invited-user), sent as <Code class=\"inline-code\">acr_values</Code> in the format <Code class=\"inline-code\">&lt;Name:Version&gt;</Code>. Login and password recovery use the login process definition on the referencing Daon TrustX Authenticator."
                    }
                ]
            }
