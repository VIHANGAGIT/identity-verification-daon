    "edit": {
        "tabs": {
            "quickStart": {
                "heading": "Add Daon TrustX IdP",
                "subHeading": "Configure the Daon TrustX OIDC connection, then reference it from a Daon TrustX Authenticator connection.",
                "steps": [
                    {
                        "title": "Configure the connection",
                        "content": "<p>Provide the <strong>Client ID</strong>, <strong>Client Secret</strong>, <strong>endpoint URLs</strong>, <strong>Scopes</strong> and the <strong>Enrol Process Definition</strong> on the <strong>Settings</strong> tab, and register the authorized redirect URI shown there as an allowed redirect URI of the OIDC client in your Daon TrustX tenant.</p>"
                    },
                    {
                        "title": "Add to an enrolment flow",
                        "content": "<p>Add this <strong>Daon TrustX IdP</strong> to a registration or invited-user flow to enrol and verify users with the configured enrol process definition.</p>"
                    },
                    {
                        "title": "Reference from a login authenticator",
                        "content": "<p>Copy this connection's <strong>resource ID</strong> and provide it as the <strong>Daon IDP ID</strong> when creating a <strong>Daon TrustX Authenticator</strong> connection. That authenticator supplies the login process definition and is what you add to login flows.</p>"
                    }
                ]
            },
